{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mhai/drift-report.schema.json",
  "title": "MHAI regression drift report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "checked_at",
    "git_read_contract",
    "mutation_boundary",
    "program",
    "targets",
    "upstream",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "MHAI-REGRESSION-DRIFT-1"
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "checked_at": {
      "type": "string",
      "minLength": 1
    },
    "git_read_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isolated_disposable_home",
        "optional_locks_environment",
        "no_optional_locks_argument",
        "target_fetch_performed"
      ],
      "properties": {
        "isolated_disposable_home": {
          "const": true
        },
        "optional_locks_environment": {
          "const": "0"
        },
        "no_optional_locks_argument": {
          "const": true
        },
        "target_fetch_performed": {
          "const": false
        }
      }
    },
    "mutation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_writes",
        "target_repairs",
        "epoch_opened",
        "rerun_authorized",
        "durable_report_written"
      ],
      "properties": {
        "target_writes": {
          "const": false
        },
        "target_repairs": {
          "const": false
        },
        "epoch_opened": {
          "const": false
        },
        "rerun_authorized": {
          "const": false
        },
        "durable_report_written": {
          "const": false
        }
      }
    },
    "program": {
      "$ref": "#/$defs/repository_result"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository_result"
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "CURRENT",
            "CHANGED",
            "UNKNOWN"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons",
        "automatic_epoch_authorized",
        "next_action"
      ],
      "properties": {
        "status": {
          "enum": [
            "NO_RERUN_TRIGGER",
            "RERUN_REVIEW_REQUIRED",
            "UNKNOWN"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "automatic_epoch_authorized": {
          "const": false
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "repository_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "baseline_commit",
        "current_commit",
        "baseline_tree",
        "current_tree",
        "working_tree_clean",
        "status",
        "changed_paths",
        "material_paths",
        "non_material_paths",
        "limitations"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "baseline_commit": {
          "type": "string",
          "minLength": 1
        },
        "current_commit": {
          "type": "string"
        },
        "baseline_tree": {
          "type": "string"
        },
        "current_tree": {
          "type": "string"
        },
        "working_tree_clean": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "CURRENT",
            "HISTORY_ONLY",
            "NON_MATERIAL_DRIFT",
            "MATERIAL_DRIFT",
            "UNKNOWN"
          ]
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "material_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_material_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
