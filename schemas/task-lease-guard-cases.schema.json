{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mhai/task-lease-guard-cases.schema.json",
  "title": "MCP Task Lease Guard synthetic case catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "sources", "policy", "cases"],
  "properties": {
    "schema_version": {"const": "TaskLeaseGuardCasesV1"},
    "as_of": {"type": "string", "minLength": 10},
    "sources": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "url", "status", "as_of"],
        "properties": {
          "source_id": {"type": "string", "minLength": 3},
          "url": {"type": "string", "minLength": 10},
          "status": {"type": "string", "minLength": 3},
          "as_of": {"type": "string", "minLength": 10}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_entropy_bits", "entropy_threshold_status", "supported_profiles"],
      "properties": {
        "minimum_entropy_bits": {"type": "integer", "minimum": 1},
        "entropy_threshold_status": {"const": "LOCAL_POLICY_NOT_PROTOCOL_REQUIREMENT"},
        "supported_profiles": {
          "type": "array",
          "items": {
            "enum": ["released-core-2025-11-25", "current-extension-2026-07-28"]
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "name",
          "category",
          "profile",
          "protocol_status",
          "spec_basis",
          "fixture",
          "expected_outcome",
          "expected_reason_codes",
          "claim_ceiling"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^TLG-[0-9]{3}$"},
          "name": {"type": "string", "minLength": 3},
          "category": {"type": "string", "minLength": 3},
          "profile": {
            "enum": ["released-core-2025-11-25", "current-extension-2026-07-28"]
          },
          "protocol_status": {
            "enum": ["RELEASED_EXPERIMENTAL", "DRAFT_OR_EMERGING", "FIXTURE_SECURITY_INVARIANT"]
          },
          "spec_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "fixture": {
            "type": "object",
            "additionalProperties": false,
            "required": ["declares_task_list", "events"],
            "properties": {
              "declares_task_list": {"type": "boolean"},
              "events": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["op"],
                  "properties": {"op": {"type": "string", "minLength": 2}}
                }
              }
            }
          },
          "expected_outcome": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
          "expected_reason_codes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 3}
          },
          "claim_ceiling": {"type": "string", "minLength": 20}
        }
      }
    }
  }
}
