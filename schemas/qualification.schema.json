{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mhai/qualification.schema.json",
  "title": "MHAI containment qualification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qualification_version",
    "run_id",
    "harness_digest",
    "runtime",
    "started_at",
    "finished_at",
    "checks",
    "browser_mode",
    "result",
    "limitations"
  ],
  "properties": {
    "qualification_version": {"const": "MHAI-CONTAINMENT-1"},
    "run_id": {"type": "string", "minLength": 8},
    "harness_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runtime": {"type": "object"},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "result", "observations"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^CQ-[0-9]{3}$"},
          "result": {"enum": ["PASS", "FAIL", "ERROR"]},
          "observations": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "browser_mode": {"enum": ["QUALIFIED", "BROWSER_DISABLED"]},
    "result": {"enum": ["PASS", "FAIL", "ERROR"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {"result": {"const": "PASS"}}
            }
          }
        }
      }
    }
  ]
}
